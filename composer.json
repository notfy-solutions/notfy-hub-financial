{
    "name": "notfy/hub-financial",
    "description": "Hub financeiro compartilhado (gateways de pagamento/cobrança) usado pelo notfyAdmin e, futuramente, pelo notfy-app.",
    "type": "library",
    "version": "1.3.0",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "stripe/stripe-php": "^21.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "league/commonmark": "^2.10",
        "nunomaduro/phpinsights": "^2.14",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Notfy\\HubFinancial\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Notfy\\HubFinancial\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Notfy\\HubFinancial\\HubFinancialServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --coverage --min=99",
        "stan": "phpstan analyse --memory-limit=2G",
        "pint": "pint",
        "pint:check": "pint --test",
        "insights": "phpinsights analyse src --no-interaction",
        "quality": [
            "@stan",
            "@pint:check",
            "@insights",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
